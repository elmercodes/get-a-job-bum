# Your personal data: profile, documents (ID, marksheets, photo), tracker, generated resumes.
data/
samples/

node_modules/
*.log
.DS_Store
.kilo/
.kilocode/

# Your own Wellfound script with your details (the Copy button prefers it). Never committed.
extension/scripts/*.local.js

# "Report this form" snapshots of real applications (scrubbed, but yours): share them when you choose.
server/test/reports/

# Claude Code tool state (oh-my-claudecode, serena)
.omc/
.serena/

# Applicant data and local credentials
/private_data/
/personal_data/
/personal/
/secrets/
/credentials/
/exports/
/generated_resumes/
/applications/
/local_backups/
*.sqlite
*.sqlite3
*.sqlite-shm
*.sqlite-wal
