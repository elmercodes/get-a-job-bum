*.local.json
*.local.yaml
*.local.yml
*.local.js
*.credentials.json
# Note: upstream ignores root data/ and server/.env; leave those intact.
# Do not indiscriminately ignore *.docx or *.pdf: fictional fixture files may be intentional.
# Instead, never place real applicant documents under a tracked path.
